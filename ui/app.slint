import { Button, VerticalBox, HorizontalBox, GridBox } from "std-widgets.slint";

component AmountButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 80px;
    background: #2d2d3d;
    border-radius: 8px;

    Text {
        text: label;
        font-size: 24px;
        font-weight: 700;
        color: white;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <color> bg: #3366cc;
    callback clicked();
    height: 70px;
    background: bg;
    border-radius: 8px;

    Text {
        text: label;
        font-size: 22px;
        font-weight: 700;
        color: white;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component NavButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 40px;
    background: transparent;

    Text {
        text: label;
        font-size: 16px;
        color: #8888aa;
        horizontal-alignment: left;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

export global WalletState {
    in-out property <string> balance: "0";
    in-out property <string> mint-url: "mint.minibits.cash";
    in-out property <string> status: "";
    in-out property <int> selected-amount: 0;
    in-out property <image> qr-image;
    in-out property <bool> qr-ready: false;
    in-out property <bool> show-check-payment: false;
    in-out property <int> current-screen: 0;
    // 0 = home, 1 = mint, 2 = send, 3 = receive, 4 = qr-view, 5 = settings

    callback request-mint-quote(int);
    callback check-mint-payment();
    callback request-send(int);
    callback receive-ble();
}

export component MainApp inherits Window {
    width: 720px;
    height: 720px;
    no-frame: true;
    background: #14141e;
    title: "Cashu Pixel";

    // Home Screen
    if WalletState.current-screen == 0: VerticalLayout {
        padding: 40px;
        spacing: 15px;

        VerticalLayout {
            spacing: 5px;
            alignment: center;
            height: 160px;

            Text {
                text: "BALANCE";
                font-size: 18px;
                color: #8888aa;
                horizontal-alignment: center;
            }
            Text {
                text: WalletState.balance + " sat";
                font-size: 52px;
                font-weight: 700;
                color: white;
                horizontal-alignment: center;
            }
            Text {
                text: WalletState.mint-url;
                font-size: 14px;
                color: #555566;
                horizontal-alignment: center;
            }
        }

        Rectangle { height: 30px; }

        HorizontalLayout {
            spacing: 15px;
            height: 100px;

            ActionButton {
                label: "SEND";
                bg: #e04444;
                clicked => { WalletState.current-screen = 2; WalletState.selected-amount = 0; WalletState.status = ""; }
            }
            ActionButton {
                label: "RECEIVE";
                bg: #33bb66;
                clicked => { WalletState.current-screen = 3; WalletState.status = ""; }
            }
        }

        Rectangle { height: 15px; }

        ActionButton {
            label: "MINT";
            bg: #dd9911;
            clicked => { WalletState.current-screen = 1; WalletState.selected-amount = 0; WalletState.status = ""; }
        }

        Rectangle { height: 15px; }

        ActionButton {
            label: "Settings";
            bg: #2a2a35;
            clicked => { WalletState.current-screen = 5; }
        }
    }

    // Mint Screen
    if WalletState.current-screen == 1: VerticalLayout {
        padding: 30px;
        spacing: 12px;

        HorizontalLayout {
            height: 40px;
            NavButton { label: "< Back"; clicked => { WalletState.current-screen = 0; } }
            Text { text: "MINT"; font-size: 24px; font-weight: 700; color: white; horizontal-alignment: center; }
            Rectangle { width: 80px; }
        }

        Rectangle { height: 10px; }

        Text {
            text: WalletState.selected-amount == 0 ? "Select amount" : WalletState.selected-amount + " sat";
            font-size: 42px;
            font-weight: 700;
            color: white;
            horizontal-alignment: center;
            height: 60px;
        }

        Rectangle { height: 10px; }

        GridLayout {
            spacing: 10px;
            Row {
                AmountButton { label: "21"; clicked => { WalletState.selected-amount = 21; } }
                AmountButton { label: "100"; clicked => { WalletState.selected-amount = 100; } }
                AmountButton { label: "500"; clicked => { WalletState.selected-amount = 500; } }
            }
            Row {
                AmountButton { label: "1000"; clicked => { WalletState.selected-amount = 1000; } }
                AmountButton { label: "5000"; clicked => { WalletState.selected-amount = 5000; } }
                AmountButton { label: "10000"; clicked => { WalletState.selected-amount = 10000; } }
            }
        }

        Rectangle { height: 15px; }

        ActionButton {
            label: "Create Lightning Invoice";
            bg: #dd9911;
            clicked => {
                if WalletState.selected-amount > 0 {
                    WalletState.status = "Creating invoice...";
                    WalletState.request-mint-quote(WalletState.selected-amount);
                }
            }
        }

        Rectangle {}

        Text {
            text: WalletState.status;
            font-size: 16px;
            color: #8888aa;
            horizontal-alignment: center;
            height: 30px;
        }
    }

    // Send Screen
    if WalletState.current-screen == 2: VerticalLayout {
        padding: 30px;
        spacing: 12px;

        HorizontalLayout {
            height: 40px;
            NavButton { label: "< Back"; clicked => { WalletState.current-screen = 0; } }
            Text { text: "SEND"; font-size: 24px; font-weight: 700; color: white; horizontal-alignment: center; }
            Rectangle { width: 80px; }
        }

        Rectangle { height: 10px; }

        Text {
            text: WalletState.selected-amount == 0 ? "Select amount" : WalletState.selected-amount + " sat";
            font-size: 42px;
            font-weight: 700;
            color: white;
            horizontal-alignment: center;
            height: 60px;
        }

        Rectangle { height: 10px; }

        GridLayout {
            spacing: 10px;
            Row {
                AmountButton { label: "10"; clicked => { WalletState.selected-amount = 10; } }
                AmountButton { label: "21"; clicked => { WalletState.selected-amount = 21; } }
                AmountButton { label: "50"; clicked => { WalletState.selected-amount = 50; } }
            }
            Row {
                AmountButton { label: "100"; clicked => { WalletState.selected-amount = 100; } }
                AmountButton { label: "500"; clicked => { WalletState.selected-amount = 500; } }
                AmountButton { label: "1000"; clicked => { WalletState.selected-amount = 1000; } }
            }
        }

        Rectangle { height: 15px; }

        ActionButton {
            label: "Show QR Code";
            bg: #e04444;
            clicked => {
                if WalletState.selected-amount > 0 {
                    WalletState.status = "Generating token...";
                    WalletState.request-send(WalletState.selected-amount);
                }
            }
        }

        Rectangle {}

        Text {
            text: WalletState.status;
            font-size: 16px;
            color: #8888aa;
            horizontal-alignment: center;
            height: 30px;
        }
    }

    // Receive Screen
    if WalletState.current-screen == 3: VerticalLayout {
        padding: 30px;
        spacing: 20px;

        HorizontalLayout {
            height: 40px;
            NavButton { label: "< Back"; clicked => { WalletState.current-screen = 0; } }
            Text { text: "RECEIVE"; font-size: 24px; font-weight: 700; color: white; horizontal-alignment: center; }
            Rectangle { width: 80px; }
        }

        Rectangle {}

        ActionButton {
            label: "Receive via Bluetooth";
            bg: #3366cc;
            height: 100px;
            clicked => {
                WalletState.status = "Listening for BLE...";
                WalletState.receive-ble();
            }
        }

        Rectangle {}

        Text {
            text: WalletState.status == "" ? "Tap to start listening" : WalletState.status;
            font-size: 20px;
            color: #66bb77;
            horizontal-alignment: center;
        }
    }

    // QR View Screen (full screen QR)
    if WalletState.current-screen == 4: VerticalLayout {
        padding: 20px;
        spacing: 10px;
        Rectangle {
            background: white;
            border-radius: 12px;

            VerticalLayout {
                padding: 15px;
                spacing: 10px;

                Image {
                    source: WalletState.qr-image;
                    image-fit: contain;
                }

                Text {
                    text: WalletState.status;
                    font-size: 18px;
                    font-weight: 700;
                    color: #222222;
                    horizontal-alignment: center;
                    height: 35px;
                }
            }
        }

        if WalletState.show-check-payment: ActionButton {
            label: "Check Payment";
            bg: #33bb66;
            clicked => {
                WalletState.status = "Checking...";
                WalletState.check-mint-payment();
            }
        }

        ActionButton {
            label: "Done";
            bg: #555555;
            clicked => {
                WalletState.current-screen = 0;
                WalletState.qr-ready = false;
                WalletState.show-check-payment = false;
                WalletState.status = "";
            }
        }
    }

    // Settings Screen
    if WalletState.current-screen == 5: VerticalLayout {
        padding: 30px;
        spacing: 15px;

        HorizontalLayout {
            height: 40px;
            NavButton { label: "< Back"; clicked => { WalletState.current-screen = 0; } }
            Text { text: "SETTINGS"; font-size: 24px; font-weight: 700; color: white; horizontal-alignment: center; }
            Rectangle { width: 80px; }
        }

        Rectangle { height: 30px; }

        Text {
            text: "Balance";
            font-size: 16px;
            color: #8888aa;
            horizontal-alignment: center;
        }
        Text {
            text: WalletState.balance + " sat";
            font-size: 36px;
            font-weight: 700;
            color: white;
            horizontal-alignment: center;
        }

        Rectangle { height: 20px; }

        Text {
            text: "Mint";
            font-size: 16px;
            color: #8888aa;
            horizontal-alignment: center;
        }
        Text {
            text: WalletState.mint-url;
            font-size: 14px;
            color: #666677;
            horizontal-alignment: center;
        }

        Rectangle {}
    }
}
